# Copy this file to .env and fill in real values locally.
# .env is gitignored — never commit real secrets.

# Etsy API v3 app credentials (https://www.etsy.com/developers/your-apps)
ETSY_API_KEY=
ETSY_SHARED_SECRET=
ETSY_API_SECRET=
ETSY_SHOP_ID=
# Must match the redirect URI registered on your Etsy app.
ETSY_REDIRECT_URI=http://localhost:8787/callback

# Supply a valid OAuth access token, or a refresh token to obtain one automatically.
ETSY_ACCESS_TOKEN=
ETSY_REFRESH_TOKEN=

# OpenAI image generation (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Printful fulfillment API (https://developers.printful.com/)
PRINTFUL_API_KEY=

# Optional recycled-photo sticker production. Use the exact product and variant
# IDs from your Printful catalog, Etsy's seller taxonomy ID for physical stickers,
# Printful's current unit cost, and the package measurements used by your shop.
ETSY_STICKER_TAXONOMY_ID=
PRINTFUL_STICKER_PRODUCT_ID=
PRINTFUL_STICKER_VARIANT_ID=
PRINTFUL_STICKER_UNIT_COST=
STICKER_SHIP_WEIGHT_OZ=
STICKER_SHIP_LENGTH_IN=
STICKER_SHIP_WIDTH_IN=
STICKER_SHIP_HEIGHT_IN=
