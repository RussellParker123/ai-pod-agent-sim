# Copy this file to .env and fill in real values locally.
# .env is gitignored — never commit real secrets.

# Etsy API v3 app credentials (https://www.etsy.com/developers/your-apps)
ETSY_API_KEY=
ETSY_SHARED_SECRET=
ETSY_API_SECRET=
ETSY_SHOP_ID=
# Must match the redirect URI registered on your Etsy app.
ETSY_REDIRECT_URI=http://localhost:8787/callback

# Supply a valid OAuth access token, or a refresh token to obtain one automatically.
ETSY_ACCESS_TOKEN=
ETSY_REFRESH_TOKEN=

# OpenAI image generation (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Printful fulfillment API (https://developers.printful.com/)
PRINTFUL_API_KEY=
